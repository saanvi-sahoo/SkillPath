# ── LLM providers ──
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
# optional
REDUCTO_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Vector database: MongoDB Atlas (docs/mongodb_atlas_setup.md) ──
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=skillpath_ai
# collections: careers_embeddings_v1, knowledge_chunks_v1, job_listings_v1, user_profile_chunks_v1 (see src/rag/config.py)
VECTOR_BACKEND=auto            # auto | mongo | local

# ── Embeddings / RAG (defaults shown; change => re-ingest, log in docs/experiment_log.md) ──
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RAG_MIN_SCORE=0.30
CAREER_MIN_SCORE=0.40
CAREER_RAG_ENABLED=true
CAREERS_CSV=docs/emerging_tech_career_dataset_cleaned.csv

# ── Generation mode (docs/keyless_mode.md) ──
LLM_PROVIDER=auto              # auto | api | local | none   (local runs: set local = Mistral via Ollama)
# Real environment variables override .env (E29). Visitors can also use their own key in the UI (docs/byok.md).
OLLAMA_MODEL=mistral
# SKILLPATH_NO_DOTENV=1         # ignore .env entirely (keyless demo instance)

# ── Chatbot ──
GEMINI_MODEL=gemini-3.5-flash
CHAT_MODEL=groq:openai/gpt-oss-120b
PROMPT_ADVISOR_SYSTEM=v4
PIPELINE_MODE=auto              # auto | api | inprocess (Streamlit Cloud)
GROQ_API_KEY_2=                 # optional; only adds quota if it belongs to a DIFFERENT Groq org
ROUTER_MODEL=groq:openai/gpt-oss-20b
SCOPE_ROUTER_MODE=hybrid       # hybrid | knn | llm
